    "perimetre_comptable": {
     "perimetre": "social",
     "lecture": "Comptes sociaux de l'entité juridique interrogée, filiales non consolidées. / Statutory accounts of the queried legal entity; subsidiaries not consolidated."
    },
    "interpretabilite": {
