{
  "name": "sirenic-agents",
  "version": "0.3.0",
  "description": "LangChain.js tools for Sirenic: official French and European company data. Pay with an API key (prepaid credits, per-call cap) or per call via x402 (USDC or EURC on Base, hard price cap).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "CHANGELOG.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc && node --test test/client.test.mjs test/tools.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirenic-eu/sirenic-examples.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://api.sirenic.eu/en/connectors?utm_source=npm&utm_campaign=sirenic-agents",
  "keywords": ["langchain", "x402", "api-key", "kyb", "france", "company-data", "agents", "sirenic"],
  "peerDependencies": {
    "@langchain/core": "^1.0.0"
  },
  "dependencies": {
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "viem": "^2.21.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.3",
    "typescript": "^5.6.0"
  }
}
